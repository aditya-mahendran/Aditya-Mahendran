# Copy to .env and fill in. Never commit .env.

# --- Slack -------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
# Socket Mode app-level token (Basic Information → App-Level Tokens, scope connections:write).
SLACK_APP_TOKEN=xapp-...
# Only needed in HTTP mode (no SLACK_APP_TOKEN); then also set PORT and a public URL.
SLACK_SIGNING_SECRET=
# Channel for picks and Confirmed/Declined posts, e.g. #kcc-programming's ID (C0123...).
NOTIFY_CHANNEL_ID=
# FR-8 weekly Monday reminders (v1.5).
REMINDERS_ENABLED=false
# Weekly check-in posted to NOTIFY_CHANNEL_ID, asking for outreach updates (cron, Chicago time).
# Default: Sundays 4:45pm ("45 16 * * 0"). Set to "off" to turn it off.
WEEKLY_CHECKIN_CRON=45 16 * * 0

# --- Store ---------------------------------------------------------------
# memory = local dev / demo (nothing saved); sheets = Google Sheet; graph = SharePoint Excel workbook.
STORE=memory
# memory store only: bind this Slack user ID to the admin row so you can try lead commands.
DEV_ADMIN_SLACK_ID=

# --- Google Sheets (STORE=sheets) ------------------------------------------
# The sheet's URL or just its ID (the long part between /d/ and /edit).
GOOGLE_SHEET_ID=
# Service account JSON key downloaded from Google Cloud. Keep it out of git.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=data/google-service-account.json
# Or paste the whole JSON key here instead (handy on hosting platforms).
GOOGLE_SERVICE_ACCOUNT_JSON=
# planning (default): panel tabs are the team's planning sheets; full rows live in Panel Tracker
# and each tab's Potential Moderators / Panelists lists and Confirmed slots are kept in step.
# rows: each panel tab is a 15-column table like Panel Tracker.
TAB_LAYOUT=planning

# --- Microsoft Graph (STORE=graph) -------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
# Option A (app-only, Sites.Selected): set the client secret.
MS_CLIENT_SECRET=
# Option B (delegated): leave the secret empty, run `npm run device-login` once.
MS_TOKEN_CACHE_PATH=data/token-cache.json
MS_REFRESH_TOKEN=
# From `npm run resolve-sharepoint`.
SP_SITE_ID=
SP_DRIVE_ID=
SP_ITEM_ID=

TZ=America/Chicago

# --- Free-text updates (FR-9) ---------------------------------------------------
# "@Peter Panel talked to Jane, she's interested" → Claude proposes the tracker change,
# the author confirms. Get a key at https://console.anthropic.com. Leave empty to turn off.
ANTHROPIC_API_KEY=
# auto (default): save straight away, reply in the thread with Undo. confirm: show Apply / Edit / Cancel first.
FREE_TEXT_MODE=auto
